{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pstack",
  "version": "0.9.82-zcode.3",
  "description": "If you want to go fast, go deep first. pstack helps you write less, but higher quality code. Rigorous agent workflows you can parallelize with confidence. ZCode port of the pstack plugin: original pstack by Lauren Tan (poteto), Claude Code port by Michael Denyer.",
  "author": {
    "name": "archeism",
    "url": "https://github.com/archeism"
  },
  "homepage": "https://github.com/archeism/pstack-zcode",
