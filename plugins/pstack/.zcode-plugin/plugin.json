    "./agents/effort-medium.md",
    "./agents/effort-xhigh.md",
    "./agents/poteto-agent-high.md",
    "./agents/poteto-agent-low.md",
    "./agents/poteto-agent-max.md",
    "./agents/poteto-agent-medium.md",
    "./agents/poteto-agent-xhigh.md"
  ]
}
